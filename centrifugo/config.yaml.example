# ==========================================================================
# Значение "default" у каждой опции = то, что будет, если её вообще не писать.
# Опции без пометки "PRO only" доступны в бесплатной версии.
# ==========================================================================

channel:

  # Настройки для каналов БЕЗ namespace (без "имя:" в начале строки).
  # Работают точно так же, как опции внутри namespace ниже.
  without_namespace:
    allow_subscribe_for_client: false   # запретить прямую подписку с клиента на "голые" каналы

  namespaces:
    - name: "example"                   # обязательное поле, уникальное имя, /^[-a-zA-Z0-9_]{2,}$/

      # ---------------------------------------------------------------
      # ПРАВА: ПОДПИСКА
      # ---------------------------------------------------------------
      allow_subscribe_for_client: false
        # default: false
        # Разрешить любому авторизованному (не анонимному) клиенту самому
        # подписаться на любой канал этого namespace без проверок бэкендом.
        # ВНИМАНИЕ: делает namespace фактически публичным.

      allow_subscribe_for_anonymous: false
        # default: false
        # То же самое, но для анонимных клиентов (пустой user ID).
        # Работает только вместе с allow_subscribe_for_client: true.

      # ---------------------------------------------------------------
      # ПРАВА: ПУБЛИКАЦИЯ (отправка сообщений прямо с клиента, минуя бэкенд)
      # ---------------------------------------------------------------
      allow_publish_for_client: false
        # default: false
        # Разрешить клиенту публиковать в канал напрямую, даже не будучи
        # подписанным на него. Данные НЕ валидируются Centrifugo.

      allow_publish_for_subscriber: false
        # default: false
        # Как выше, но публиковать может только тот, кто уже подписан
        # на этот же канал.

      allow_publish_for_anonymous: false
        # default: false
        # Разрешить публикацию анонимным клиентам (нужен один из allow_publish_* выше).

      # ---------------------------------------------------------------
      # ПРАВА: HISTORY (получение истории сообщений канала)
      # ---------------------------------------------------------------
      allow_history_for_client: false
        # default: false
        # Разрешить любому клиенту запрашивать историю канала (даже без подписки).

      allow_history_for_subscriber: false
        # default: false
        # Разрешить только подписчикам канала запрашивать его историю.

      allow_history_for_anonymous: false
        # default: false
        # Разрешить историю анонимным клиентам (нужен один из allow_history_* выше).

      # ---------------------------------------------------------------
      # ПРАВА: PRESENCE (кто сейчас онлайн в канале)
      # ---------------------------------------------------------------
      allow_presence_for_client: false
        # default: false
        # Разрешить любому клиенту запрашивать presence канала.

      allow_presence_for_subscriber: false
        # default: false
        # Разрешить presence только подписчикам этого канала.

      allow_presence_for_anonymous: false
        # default: false
        # Разрешить presence анонимным клиентам (нужен один из allow_presence_* выше).

      # ---------------------------------------------------------------
      # PRESENCE / JOIN-LEAVE (само наличие фичи, отдельно от прав на её вызов)
      # ---------------------------------------------------------------
      presence: false
        # default: false
        # Включает сбор presence-данных для каналов namespace вообще.
        # Без этого allow_presence_for_* не имеют смысла — данных просто нет.
        # Расходует память/CPU — включайте только там, где реально нужно.

      join_leave: false
        # default: false
        # Генерировать событие при подписке/отписке клиента (join/leave).
        # Осторожно: в каналах с большим числом подписчиков это может дать
        # лавинообразный рост сообщений (N подписчиков -> N сообщений на событие).

      force_push_join_leave: false
        # default: false
        # Пушить join/leave-события ВСЕМ клиентам автоматически.
        # Без этого клиент должен сам запросить их (и иметь на это право).

      # ---------------------------------------------------------------
      # HISTORY (хранение сообщений в канале для восстановления/чтения)
      # ---------------------------------------------------------------
      history_size: 0
        # default: 0 (история выключена)
        # Максимум сообщений, хранимых в истории на канал.
        # Работает ТОЛЬКО вместе с history_ttl — одного этого поля недостаточно.

      history_ttl: "0s"
        # default: "0s" (история выключена)
        # Сколько хранить сообщения истории. Нужно задать вместе с history_size.

      history_meta_ttl: "720h"
        # default: наследуется от глобального channel.history_meta_ttl (30 дней)
        # TTL метаданных стрима (последний offset/epoch). Если history_ttl
        # у вас больше 30 дней — этот параметр надо увеличить, иначе
        # метаданные протухнут раньше самой истории.

      # ---------------------------------------------------------------
      # RECOVERY / POSITIONING (восстановление после разрыва соединения)
      # ---------------------------------------------------------------
      force_positioning: false
        # default: false
        # Принудительно включить контроль позиции клиента в стриме для ВСЕХ
        # подписчиков namespace. Требует настроенных history_size + history_ttl.

      allow_positioning: false
        # default: false
        # Как force_positioning, но клиент включает это сам (не обязательно
        # для всех). Тоже требует history_size + history_ttl.

      force_recovery: false
        # default: false
        # Принудительно включить восстановление пропущенных сообщений после
        # реконнекта для ВСЕХ подписчиков. Требует history_size + history_ttl.
        # Автоматически включает поведение force_positioning.

      allow_recovery: false
        # default: false
        # Как force_recovery, но клиент включает это опционально сам.

      force_recovery_mode: "stream"
        # default: "stream"; альтернатива — "cache"
        # "stream" — восстанавливаются все пропущенные сообщения по порядку.
        # "cache" — при (пере)подписке отдаётся только последнее сообщение
        # (актуальное состояние), а не весь пропущенный поток.

      auto_cache_recover: false
        # default: false (с v6.8.3)
        # Автоматически отдавать последнее сообщение при каждой подписке,
        # без явного запроса от клиента. Нужны force_recovery: true и
        # force_recovery_mode: "cache".

      # ---------------------------------------------------------------
      # ПРОЧИЕ ОГРАНИЧЕНИЯ / ФОРМАТ
      # ---------------------------------------------------------------
      allow_user_limited_channels: false
        # default: false
        # Разрешить каналы вида "namespace:news#42" — доступны только
        # перечисленным через запятую user ID.

      channel_regex: ""
        # default: "" (без ограничений)
        # Регулярка (Go regexp) на часть имени канала ПОСЛЕ "namespace:".
        # Пример: "^[0-9]+$" разрешит только "example:123", но не "example:abc".
        # Проверяется только при подписке с клиента, не для server-side подписок.

      delta_publish: false
        # default: false
        # Помечать все публикации в namespace как дельта-совместимые —
        # подписчикам, договорившимся о дельта-сжатии, будут приходить
        # только изменения, а не полное сообщение целиком.

      allowed_delta_types: []
        # default: [] (дельта-сжатие недоступно клиентам)
        # Список разрешённых алгоритмов дельта-компрессии. Сейчас
        # единственное значение — "fossil".

      publication_data_format: ""
        # default: "" — без проверки формата данных
        # "json" — публикуемые данные должны быть валидным JSON
        # "json_object" — вдобавок обязательно JSON-объект (не массив/примитив)
        # "binary" — данные произвольные бинарные, пустые payload разрешены

      allow_tags_filter: false
        # default: false (с v6.4.0)
        # Разрешить клиенту при подписке фильтровать сообщения по тегам.

      # ---------------------------------------------------------------
      # PROXY (привязка namespace к конкретному прокси-обработчику на бэкенде)
      # ---------------------------------------------------------------
      subscribe_proxy_enabled: false
        # default: false — включить subscribe proxy для этого namespace
      subscribe_proxy_name: ""
        # default: "" — использовать конкретный именованный proxy из массива proxies

      publish_proxy_enabled: false
        # default: false — включить publish proxy (валидация/сохранение публикаций на бэкенде)
      publish_proxy_name: ""
        # default: "" — имя конкретного publish proxy

      sub_refresh_proxy_enabled: false
        # default: false — включить проверку продления подписки через бэкенд
      sub_refresh_proxy_name: ""
        # default: "" — имя конкретного sub-refresh proxy

      subscribe_stream_proxy_enabled: false
        # default: false — включить проксирование подписки как стрима (см. proxy_streams)
      subscribe_stream_proxy_name: ""
        # default: "" — имя конкретного subscribe-stream proxy
      subscribe_stream_proxy_bidirectional: false
        # default: false — сделать subscribe-stream двунаправленным

      # ---------------------------------------------------------------
      # BATCHING (группировка сообщений перед отправкой клиенту)
      # ---------------------------------------------------------------
      batch_max_size: 0
        # default: 0 (батчинг выключен) — макс. число сообщений в одном батче
      batch_max_delay: "0s"
        # default: "0s" — максимальная задержка перед отправкой накопленного батча
      batch_flush_latest: false
        # default: false — отправлять из батча только последнее сообщение,
        # остальные отбрасывать (полезно для "состояние", а не "лента событий")

      # ---------------------------------------------------------------
      # ТОЛЬКО В CENTRIFUGO PRO — ниже опции недоступны в open-source версии
      # ---------------------------------------------------------------
      cache_empty_proxy_enabled: false   # [PRO] уведомление бэкенда, когда cache recovery не нашёл данных
      cache_empty_proxy_name: ""         # [PRO] имя конкретного cache-empty proxy

      state_proxy_enabled: false         # [PRO] уведомления о состоянии канала (пуст/занят)
      state_events: []                   # [PRO] какие именно state-события слать ("occupied", "vacated")

      shared_position_sync: false        # [PRO] снижает число запросов позиции к брокеру при масштабировании

      subscribe_cel: ""                  # [PRO] CEL-выражение — динамическое право на подписку
      publish_cel: ""                    # [PRO] CEL-выражение — динамическое право на публикацию
      history_cel: ""                    # [PRO] CEL-выражение — динамическое право на историю
      presence_cel: ""                   # [PRO] CEL-выражение — динамическое право на presence

      allow_channel_compaction: false    # [PRO] разрешить SDK договариваться о компакции канала