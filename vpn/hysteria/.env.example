PROJECT_NAME=vpn-hysteria
NETWORK=project-network

HYSTERIA_IMAGE=tobyxdd/hysteria:v2
HYSTERIA_CONTAINER=hysteria-container

# UDP. Hysteria 2 uses QUIC, so Nginx Proxy Manager is not involved.
HYSTERIA_BIND_IP=0.0.0.0
HYSTERIA_PORT=443

# Public address that clients will use.
# Recommended: a real domain with DNS A/AAAA pointing to the server.
# No-domain mode is possible with self-signed cert + insecure=1 + pinSHA256.
HYSTERIA_HOST=vpn.example.com
HYSTERIA_CLIENT_NAME=vennro-hysteria

# acme | cert
# acme: Hysteria obtains a trusted cert for HYSTERIA_HOST.
# cert: use cert/key from HYSTERIA_CERTS_HOST_PATH mounted into the container.
HYSTERIA_TLS_MODE=cert
HYSTERIA_SNI=vpn.example.com

# For TLS_MODE=acme.
HYSTERIA_ACME_EMAIL=admin@example.com
HYSTERIA_ACME_CA=letsencrypt
HYSTERIA_ACME_DIR=/etc/hysteria/acme
HYSTERIA_ACME_TYPE=http
HYSTERIA_ACME_LISTEN_HOST=0.0.0.0
HYSTERIA_ACME_HTTP_PORT=80

# For TLS_MODE=cert.
# Default points to ./certs in this module. For NPM/Let's Encrypt, mount the
# host directory that contains fullchain.pem and privkey.pem.
HYSTERIA_CERTS_HOST_PATH=./certs
HYSTERIA_CERT_PATH=/etc/hysteria/certs/fullchain.pem
HYSTERIA_KEY_PATH=/etc/hysteria/certs/privkey.pem

HYSTERIA_PASSWORD=change-me
HYSTERIA_OBFS_PASSWORD=change-me
HYSTERIA_MASQUERADE_URL=https://www.microsoft.com

# Client TLS options for generated link.
# For a trusted domain certificate: insecure=0 and empty pin.
# For self-signed cert: insecure=1 and set pin via `make fingerprint`.
HYSTERIA_CLIENT_INSECURE=0
HYSTERIA_CLIENT_PIN_SHA256=
