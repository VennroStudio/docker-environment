# Часовой пояс контейнеров
TZ=Etc/UTC
# Уровень логирования
LOG_LEVEL=INFO
# Подсеть внутри docker контейнера
SUBNET=192.168.203.0/24

# Имя compose-проекта
COMPOSE_PROJECT_NAME=name-mail
# Название в интерфейсе
SITENAME=Name.Почта
# Главный домен @domain.ru
DOMAIN=domain.ru
# Публичные имена сервера через запятую
HOSTNAMES=mail.domain.ru
# Ссылка из интерфейса
WEBSITE=https://mail.domain.ru
# Логин postmaster без домена
POSTMASTER=postmaster
# Адреса для DMARC отчетов
DMARC_RUA=postmaster
DMARC_RUF=postmaster

# Режим TLS сертификатов
TLS_FLAVOR=letsencrypt

# Отключить отправку статистики
DISABLE_STATISTICS=True
# Включить web-админку
ADMIN=true
# Webmail клиент
WEBMAIL=roundcube
# Включить REST API
API=true
# CardDAV/CalDAV сервис
WEBDAV=radicale
# Антивирус для писем
ANTIVIRUS=clamav
# Проверка вложений на макросы
SCAN_MACROS=true
# Включить забор почты с внешних ящиков
FETCHMAIL_ENABLED=true
# Интервал fetchmail в секундах
FETCHMAIL_DELAY=600

# Полнотекстовый поиск IMAP
# off отключит, языки указываются через запятую
FULL_TEXT_SEARCH=ru,en

# Сложность хеширования паролей
CREDENTIAL_ROUNDS=12

# Токен доступа к REST API
API_TOKEN=JHGDASBDMNWHGSAKUFJASASDASDDFGCS
# Случайная 16-байтовая строка
SECRET_KEY=DASDAS65DASMNBDS

# Лимит неудачных входов с IP
AUTH_RATELIMIT_IP=3/hour
# Лимит неудачных входов на пользователя
AUTH_RATELIMIT_USER=12/day
# Лимит исходящих писем на пользователя
MESSAGE_RATELIMIT=50/day
# Порог спама для новых пользователей
DEFAULT_SPAM_THRESHOLD=80
# Максимальный размер письма в байтах
# Вложения будут примерно на треть меньше
MESSAGE_SIZE_LIMIT=50000000
# Разделитель email-алиасов
RECIPIENT_DELIMITER=+

# Куда редиректить корень сайта
WEBROOT_REDIRECT=/webmail
# Путь к админке
WEB_ADMIN=/admin
# Путь к webmail
WEB_WEBMAIL=/webmail
# Путь к API
WEB_API=/api

# Сжатие новых писем на диске
# zstd/3 экономит место без сильной нагрузки
COMPRESSION=zstd
# Уровень сжатия zstd
COMPRESSION_LEVEL=3

# Поиск/OCR по вложениям через Tika
FULL_TEXT_SEARCH_ATTACHMENTS=

# Заголовок с реальным IP за reverse proxy
REAL_IP_HEADER=

# Доверенные IP reverse proxy через запятую
REAL_IP_FROM=

# Отклонять письма неизвестным получателям
REJECT_UNLISTED_RECIPIENT=

# Приветственное письмо новым пользователям
WELCOME=false
WELCOME_SUBJECT=
WELCOME_BODY=

# Доверенные сети без SMTP-авторизации
# Опасно: ошибка может открыть relay
RELAYNETS=
# Внешний SMTP relay для всей исходящей почты
RELAYHOST=