PROJECT_NAME=vpn-xray
NETWORK=project-network

XRAY_IMAGE=ghcr.io/xtls/xray-core:26.7.28
XRAY_CONTAINER=xray-container

# TCP. 443 is best if it is free; 9443 is convenient when NPM already owns 443/tcp.
XRAY_BIND_IP=0.0.0.0
XRAY_PORT=9443

XRAY_HOST=vpn.example.com
XRAY_CLIENT_NAME=vennro-xray

XRAY_LOG_LEVEL=warning
XRAY_CLIENT_UUID=change-me
XRAY_CLIENT_FLOW=xtls-rprx-vision
XRAY_CLIENT_ENCRYPTION=none
XRAY_CLIENT_FINGERPRINT=chrome

# REALITY target. SNI must match one of serverNames.
XRAY_REALITY_DEST=www.microsoft.com:443
XRAY_REALITY_SERVER_NAME=www.microsoft.com
XRAY_REALITY_PRIVATE_KEY=change-me
XRAY_REALITY_PUBLIC_KEY=change-me
XRAY_REALITY_SHORT_ID=change-me
XRAY_REALITY_SPIDER_X=/
