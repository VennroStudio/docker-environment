PROJECT_NAME=project-name

NETWORK=project-network

GLITCHTIP_VERSION=6

VOLUME=project-volume

DATABASE_URL=postgres://postgres:postgres@postgres-container:5432/glitchtip
VALKEY_URL=redis://:secret@redis-container:6379/1

SECRET_KEY=change-me
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=glitchtip@example.com
GLITCHTIP_DOMAIN=https://glitchtip.example.com

ALLOWED_HOSTS=glitchtip.example.com
CSRF_TRUSTED_ORIGINS=https://glitchtip.example.com

ENABLE_USER_REGISTRATION=True
ENABLE_ORGANIZATION_CREATION=False
ENABLE_ADMIN=False
ENABLE_OPENAPI=False

GLITCHTIP_ENABLE_UPTIME=True
GLITCHTIP_ENABLE_LOGS=True
GLITCHTIP_ENABLE_MCP=False
GLITCHTIP_ENABLE_DUCKDB=False
GLITCHTIP_RETENTION_DAYS=90

SERVER_ROLE=all_in_one
