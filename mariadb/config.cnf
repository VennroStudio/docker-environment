[mysqld]

bind-address = 0.0.0.0                        # Слушать все интерфейсы внутри контейнера

character-set-server = utf8mb4                # Кодировка по умолчанию
collation-server = utf8mb4_unicode_ci         # Сортировка по умолчанию

max_allowed_packet = 256M                     # Максимальный размер пакета

wait_timeout = 600                            # Таймаут неактивного соединения, сек
interactive_timeout = 600                     # Таймаут для интерактивных клиентов, сек

innodb_buffer_pool_size = 7G                  # Кэш данных и индексов InnoDB в памяти
innodb_buffer_pool_instances = 4              # Количество отдельных инстансов buffer pool
innodb_log_file_size = 768M                   # Размер лог-файла InnoDB
innodb_flush_method = O_DIRECT                # Режим flush без двойной буферизации через page cache
innodb_file_per_table = 1                     # Отдельный .ibd файл на каждую таблицу
innodb_io_capacity = 3000                     # Базовая пропускная способность диска для фонового flush
innodb_io_capacity_max = 6000                 # Потолок пропускной способности при всплесках нагрузки
innodb_read_io_threads = 8                    # Количество потоков чтения
innodb_write_io_threads = 8                   # Количество потоков записи

skip-name-resolve                             # Отключить DNS-резолвинг клиентов

slow_query_log = 1                            # Включить лог медленных запросов
slow_query_log_file = /var/log/mysql/mariadb-slow.log
long_query_time = 5                           # Порог медленного запроса, сек

max_connections = 300                         # Максимальное количество одновременных соединений

innodb_flush_log_at_trx_commit = 1            # Синхронизация лога транзакций с диском при каждом commit
sync_binlog = 1                               # Синхронизация бинарного лога с диском при каждом commit

table_open_cache = 2000                       # Кэш открытых таблиц
thread_cache_size = 50                        # Кэш потоков для новых соединений
tmp_table_size = 128M                         # Лимит временных таблиц в памяти
max_heap_table_size = 128M                    # Лимит MEMORY-таблиц